# Database
DATABASE_URL="postgresql://user:password@localhost:5432/crestline?schema=public"

# NextAuth
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Provider Configuration (Sandbox Mode)
NEXT_PUBLIC_PROVIDER_MODE="sandbox"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Webhook Secrets
WEBHOOK_SECRET="your-webhook-secret-here"

# Banking Provider (Production)
# BANKING_PROVIDER_API_KEY=""
# BANKING_PROVIDER_API_URL=""