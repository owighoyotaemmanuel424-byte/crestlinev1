# ============================================
# Crestline Capital - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env files to version control

# --------------------------------------------
# DATABASE
# --------------------------------------------
# PostgreSQL connection string for production
DATABASE_URL=""

# Direct URL for Prisma (optional, for connection pooling)
DIRECT_URL=""

# --------------------------------------------
# AUTHENTICATION
# --------------------------------------------
# JWT Secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=""

# JWT expiration time (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN="1h"

# Encryption key for sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=""

# --------------------------------------------
# APPLICATION
# --------------------------------------------
# Application URL (used for callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Provider mode: "sandbox" for development, "production" for live
NEXT_PUBLIC_PROVIDER_MODE="sandbox"

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# WEBHOOK
# --------------------------------------------
# Webhook secret for verifying incoming webhooks
WEBHOOK_SECRET=""

# --------------------------------------------
# BANKING PROVIDER (Production)
# Uncomment and configure when using live banking provider
# --------------------------------------------
# BANKING_PROVIDER_API_KEY=""
# BANKING_PROVIDER_API_URL=""
# BANKING_PROVIDER_WEBHOOK_URL=""

# --------------------------------------------
# EMAIL (Optional - for notifications)
# --------------------------------------------
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="noreply@crestline.capital"

# --------------------------------------------
# FILE UPLOADS (Optional)
# --------------------------------------------
# MAX_FILE_SIZE=5242880
# UPLOAD_DIR="./uploads"

# --------------------------------------------
# LOGGING
# --------------------------------------------
# LOG_LEVEL="info"
